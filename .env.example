# Copy to .env and fill in. .env is gitignored and must never be committed.

# Provider key. Use a THROWAWAY key with a hard spend cap set on the provider side.
# Revoke it when the run is finished.
OPENAI_API_KEY=sk-your-throwaway-key-here

# Bifrost virtual keys, created in the web UI at localhost:8080
# These are the three roles. Values look like sk-bf-xxxxx
# Access follows function, not seniority. Ordered narrowest to widest:
#   interpreter - narrowest (needs the calendar: names, parties, dates, hearing types)
#   reporter    - middle    (that, plus minute orders, motion decisions, in camera hearings)
#   clerk       - widest    (audits the case live; if the clerk can't see it, court stops)
VK_INTERPRETER=sk-bf-replace-me
VK_REPORTER=sk-bf-replace-me
VK_CLERK=sk-bf-replace-me

# Gateway address. Bifrost's default host port is 8080. This run remapped to 8090
# because 8080 was already occupied on the host. Set this to whatever host port
# you map the container to (docker run -p <HOST_PORT>:8080 ...). The scripts and
# the dry-run URL check both read this value, so they follow whatever you set.
BIFROST_URL=http://localhost:8090

# The three models under test. ONE provider key reaches all three.
# Price tiers are MODEL tiers, not key tiers. Do not create three provider keys.
#
# The tier label names the ACCESS LEVEL, not the cost. This is a least-privilege
# piece: what matters about a resource is how far down the list of people it
# should reach, not what it costs.
#   routine    - anyone doing the work can use it
#   standard   - the middle tier
#   restricted - you need a reason for it
# They do get more expensive going down, which is why the budgets move with them.
#
# Confirm what your key can reach before you start:
#   curl https://api.openai.com/v1/models \
#     -H "Authorization: Bearer $OPENAI_API_KEY" | grep '"id"'
#
# Some models are gated by OpenAI usage tier. Check the Limits page in the
# OpenAI dashboard. Do not chase a gated model. The "restricted" tier only needs
# to cost more than the other two.
#
# All three must pass the pre-flight (a direct call, bypassing Bifrost) before
# Block 1. Otherwise a provider rejection later is indistinguishable from a
# gateway denial.
MODEL_ROUTINE=openai/gpt-5.6-luna
MODEL_STANDARD=openai/gpt-5.6-terra
MODEL_RESTRICTED=openai/gpt-6-astra

# STUB: second provider for failover testing. Out of scope this pass.
# ANTHROPIC_API_KEY=
